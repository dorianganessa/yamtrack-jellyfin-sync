# Copy to .env and replace the example paths and IDs before running.
YAMTRACK_DB_DIR=/path/to/yamtrack/db
YAMTRACK_USER_ID=1
JELLYFIN_USER_ID=00000000000000000000000000000001
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_SECRET_FILE=./secrets/jellyfin_api_key
SYNC_STATE_DIR=./state
PUID=1000
PGID=1000
SYNC_DRY_RUN=true
SYNC_INTERVAL=300
SYNC_MAX_WRITES=100
SYNC_WRITE_DELAY=0.1
SYNC_HTTP_TIMEOUT=20
SYNC_HTTP_RETRIES=2
SYNC_REPORT_RETENTION=100
